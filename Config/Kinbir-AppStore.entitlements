<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push notifications, for TestFlight and App Store builds only (D-449).
	     The free SideStore build is signed without this, because a free Apple ID
	     cannot sign push. fastlane adds it through CODE_SIGN_ENTITLEMENTS. -->
	<key>aps-environment</key>
	<string>production</string>
</dict>
</plist>
