default_platform(:ios)

PROJECT = "Kinbir.xcodeproj"
SCHEME = "Kinbir"
APP_TARGET = "Kinbir"

platform :ios do
  desc "Build, sign, and upload a new build to TestFlight (runs on GitHub Actions)"
  lane :beta do
    bundle_id = ENV.fetch("BUNDLE_ID", "com.geni.kinbir")
    team_id = ENV.fetch("APPLE_TEAM_ID")

    # Temporary keychain so signing works on a fresh CI machine.
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
      is_key_content_base64: true,
      in_house: false
    )

    # First run creates the distribution certificate and provisioning profile
    # and stores them (encrypted) in the private match repo. Later runs reuse them.
    match(
      type: "appstore",
      readonly: false,
      app_identifier: bundle_id,
      team_id: team_id,
      api_key: api_key
    )

    profile_name = ENV.fetch("sigh_#{bundle_id}_appstore_profile-name")

    update_code_signing_settings(
      path: PROJECT,
      use_automatic_signing: false,
      targets: [APP_TARGET],
      team_id: team_id,
      bundle_identifier: bundle_id,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name
    )

    increment_build_number(
      xcodeproj: PROJECT,
      build_number: ENV.fetch("BUILD_NUMBER", "1")
    )

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      # Push notifications only in this build; the App ID needs the Push
      # Notifications capability turned on (docs/app-store.md, step 3).
      xcargs: "CODE_SIGN_ENTITLEMENTS=Config/Kinbir-AppStore.entitlements",
      export_options: {
        provisioningProfiles: { bundle_id => profile_name }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
